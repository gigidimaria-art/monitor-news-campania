# Copiare in ".env" per l'esecuzione locale (NON committare il file ".env" reale)

# --- Database Neon PostgreSQL ---
DATABASE_URL=postgresql://utente:password@host.neon.tech/nomedb?sslmode=require

# --- Notifiche email ---
EMAIL_MITTENTE=tuoaccount@gmail.com
EMAIL_PASSWORD=password_applicazione
EMAIL_DESTINATARIO=destinatario1@example.com,destinatario2@example.com

# --- SMTP (opzionali: default preimpostato per Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- URL da monitorare (opzionale: ha già un default nel codice) ---
TARGET_URL=https://agricoltura.regione.campania.it/

# --- Estensione futura: notifiche Telegram (opzionali) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
